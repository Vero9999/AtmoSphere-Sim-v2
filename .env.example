# Salin file ini menjadi .env lalu sesuaikan.

# Pilihan: mock (demo tanpa LLM) | ollama (Gemma lokal) | google (Google AI Studio)
LLM_BACKEND=mock

# Nama model Gemma 4. Kosongkan untuk memakai default:
#   google -> gemma-4-26b-a4b-it  (alternatif: gemma-4-31b-it, lebih pintar tapi lebih lambat)
#   ollama -> gemma4:e4b          (laptop tanpa GPU: gemma4:e2b lebih ringan)
GEMMA_MODEL=

# Untuk LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434

# Untuk LLM_BACKEND=google (buat key gratis di https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Tingkat "berpikir" Gemma 4 (google): minimal = paling cepat (±2 dtk). Kosongkan untuk default model (±18 dtk).
GEMMA_THINKING=minimal
